{
  "name": "dsh-chat-comfort",
  "version": "1.0.2",
  "description": "Conservative chat reading enhancements for DSH 0.2.1-rc.2 and rc.3",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs/COMPATIBILITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "assets"
  ],
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm run typecheck && npm run lint && npm test",
    "pack:release": "node scripts/pack-release.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@types/react": "18.3.26",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "playwright-core": "1.56.1",
    "react": "18.3.1",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.25.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/379385796-sys/dsh-chat-comfort.git"
  },
  "homepage": "https://github.com/379385796-sys/dsh-chat-comfort#readme",
  "bugs": {
    "url": "https://github.com/379385796-sys/dsh-chat-comfort/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin"
  ]
}
